# Mapbox public token for the interactive globe. Without it the landing page
# uses the bundled spinning-Earth fallback.
NEXT_PUBLIC_MAPBOX_TOKEN=

# OpenAI-compatible chat completion endpoint used by /api/chat.
# The chatbot still works without this key, returning grounded local answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional custom endpoint, for example https://api.openai.com/v1
OPENAI_BASE_URL=
