# Mapbox public token for the original interactive globe on the landing page.
NEXT_PUBLIC_MAPBOX_TOKEN=

# OpenAI-compatible chat completion endpoint used by /api/chat.
# The chatbot still works without this key, returning grounded local answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional custom endpoint, for example https://api.openai.com/v1
OPENAI_BASE_URL=
# Optional request timeout in milliseconds (default 90000).
OPENAI_TIMEOUT_MS=90000
# Optional for Gemini: "low", "medium", or "high" can reduce response latency.
OPENAI_REASONING_EFFORT=

# Gemini shortcut:
# GEMINI_API_KEY=your_google_ai_studio_key
# If the key starts with AIza, the route automatically uses:
# https://generativelanguage.googleapis.com/v1beta/openai
# and defaults to gemini-2.0-flash. Set OPENAI_MODEL to override.
#
# If you use OPENAI_API_KEY with a Gemini key instead, either set
# OPENAI_BASE_URL explicitly or let the AIza key prefix auto-detect it.
