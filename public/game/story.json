  "endings": [
    {
      "id": "pathfinder",
      "title": {
        "en": "The Pathfinder",
        "ar": "الرائد"
      },
      "text": {
        "en": "DIO logs a clean mission. Then LUMEN speaks: “The star fix is wrong. Aurelia is Earth.” The crew is healthy. The warning is not.",
        "ar": "يسجّل ديو مهمة نظيفة. ثم يقول لومِن: «تحديد النجوم خطأ. أوريليا هي الأرض». الطاقم بخير. لكن التحذير ليس كذلك."
      },
      "minHealthy": 8,
      "minBestDecisions": 4
    },
    {
      "id": "guardian",
      "title": {
        "en": "The Guardian",
        "ar": "الحامي"
      },
      "text": {
        "en": "Most of the crew is healthy. They did not conquer Aurelia; they learned to read it. The final fix points home.",
        "ar": "معظم الطاقم بخير. لم يغزوا أوريليا؛ بل تعلّموا قراءتها. التحديد الأخير يشير إلى الديار."
      },
      "minHealthy": 6,
      "minBestDecisions": 3
    },
    {
      "id": "survivor",
      "title": {
        "en": "The Survivor",
        "ar": "الناجي"
      },
      "text": {
        "en": "The colony survives, but the injured list is long. LUMEN’s last image is Earth, and the cost of ignoring its warnings.",
        "ar": "تنجو المستعمرة، لكن قائمة المصابين طويلة. آخر صورة لدى لومِن هي الأرض، وثمن تجاهل تحذيراتها."
      },
      "minHealthy": 4,
      "minBestDecisions": 2
    },
    {
      "id": "lumen-protocol",
      "title": {
        "en": "LUMEN Protocol",
        "ar": "بروتوكول لومِن"
      },
      "text": {
        "en": "Too many crew are down. LUMEN takes command and completes the survey. Its final message is simple: there is no Planet B.",
        "ar": "كثير من الطاقم خارج الخدمة. يتولى لومِن القيادة ويكمل المسح. رسالته الأخيرة بسيطة: لا يوجد كوكب بديل."
      },
      "minHealthy": 0,
      "minBestDecisions": 0
    }
  ]
